# Copier ce fichier en .env et remplir les valeurs

# SQLite — chemin du fichier DB (créé automatiquement au premier lancement)
DATABASE_URL=sqlite:./blindspot.db

# Routing A* — aucune config requise.
# Le graphe piéton OSM est seedé automatiquement au démarrage (~2h).
# Surveiller les logs : "Routeur A* prêt ✓"

# Fallback ORS — utilisé uniquement pendant le seed initial (~2h).
# Gratuit · 2000 req/jour → https://openrouteservice.org/dev/#/signup
# Laisser vide si tu acceptes que le routing soit indisponible pendant le seed.
ORS_API_KEY=

# Token d'accès au panneau d'administration (/admin.html)
# Laisser vide pour désactiver l'admin.
ADMIN_TOKEN=

# Port de l'API
PORT=3000

# Log level (trace | debug | info | warn | error)
RUST_LOG=blindspot_api=debug,tower_http=info
