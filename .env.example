# Copier ce fichier en .env et remplir les valeurs

# SQLite — chemin du fichier DB (créé automatiquement au premier lancement)
DATABASE_URL=sqlite:./blindspot.db

# Clé API OpenRouteService (routing côté serveur)
# Gratuit · 2000 req/jour → https://openrouteservice.org/dev/#/signup
# Laisser vide si le routing est géré côté frontend.
ORS_API_KEY=

# Port de l'API
PORT=3000

# Log level (trace | debug | info | warn | error)
RUST_LOG=blindspot_api=debug,tower_http=info
