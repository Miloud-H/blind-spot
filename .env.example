# Copier ce fichier en .env et remplir les valeurs

# SQLite — chemin du fichier DB (créé automatiquement au premier lancement)
DATABASE_URL=sqlite:./blindspot.db

# Routing — deux options (Valhalla est prioritaire si défini) :
#
# Option 1 : Valhalla self-hosted (recommandé — aucune fuite de données)
#   Voir docker-compose.yml pour le setup (extrait BBBike Montréal ~15 MB).
VALHALLA_URL=

# Option 2 : ORS API publique (fallback si VALHALLA_URL est vide)
#   Gratuit · 2000 req/jour → https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Token d'accès au panneau d'administration (/admin.html)
# Laisser vide pour désactiver l'admin.
ADMIN_TOKEN=

# Port de l'API
PORT=3000

# Log level (trace | debug | info | warn | error)
RUST_LOG=blindspot_api=debug,tower_http=info
